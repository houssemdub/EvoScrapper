# ==========================================
# EvoScrapper Configuration Template
# Copy this file to .env and configure your settings
# ==========================================

# Server Settings
HOST=0.0.0.0
PORT=8009
DEBUG=false
API_KEY=
# List setting: JSON array, comma-separated values, or * for all
ALLOWED_ORIGINS=["*"]

# Proxy (Optional: http://user:pass@host:port or socks5://...)
HTTP_PROXY=

# Timeouts & Concurrency
DEFAULT_TIMEOUT=4.0
CIRCUIT_BREAKER_FAIL_THRESHOLD=3
CIRCUIT_BREAKER_RECOVERY_TIME=90.0

# Subtitle Provider API Keys (Optional)
SUBDL_API_KEY=
SUBSOURCE_API_KEY=
OPENSUBTITLES_API_KEY=
WYZIE_API_KEY=
JIMAKU_API_KEY=

# Debrid Provider API Keys (Optional - Enables instant high-speed cloud playback)
REALDEBRID_API_KEY=
ALLDEBRID_API_KEY=
DEBRIDLINK_API_KEY=
PREMIUMIZE_API_KEY=
TORBOX_API_KEY=
PIKPAK_USER=
PIKPAK_PASSWORD=

# Cache Settings
CACHE_TTL_SEARCH=900
CACHE_TTL_TRENDING=3600

# Streaming & Transmuxing Settings
STREAM_CACHE_DIR=.stream_cache
MAX_DISK_CACHE_GB=15
VLC_PATH=
STREAM_PORT=8889
# Loopback keeps the internal daemon unreachable from the LAN. Only change this
# if you intentionally run the daemon on a separate host/container.
STREAM_BIND_HOST=127.0.0.1
# Optional shared secret. Blank = generated once in .stream_cache/streamer.token.
STREAMER_TOKEN=
# Lifetime of HMAC-signed internal media URLs used by FFmpeg/ffprobe.
STREAM_URL_TTL_SECONDS=1800
TORRENT_PORT=50000
DHT_PORT=50001
EVO_DIRECT_RANGE=true
PREWARM_SWARMS=false
QUALITY_LADDER=false
JACKETT_URL=
JACKETT_API_KEY=
# - PREWARM_SWARMS: Background-resolve top search results' swarm metadata so click-to-play skips the metadata wait (default: false).
# - QUALITY_LADDER [P5]: Offer lower-bitrate releases of the same episode for hot-swap on sustained starvation (default: false).
# - JACKETT_URL / JACKETT_API_KEY [T4.5]: Local Jackett/Prowlarr Torznab passthrough; joins the search pool when both are set.
EVO_STORE_CACHE_SLOTS=128
EVO_KEEP_CACHE_MB=15360
EVO_MAX_WEB_CONNS=50
EVO_MAX_CONCURRENT_FFMPEG=4
EVO_HLS_MAX_CONCURRENCY=3
EVO_HLS_CACHE_MAX_MB=2048
EVO_HLS_LEGACY_SLICE=false

# ==============================================================================
# Streaming Tuning Guide (Flaw-to-Knob Mapping)
# ==============================================================================
# - STREAM_PORT [STRM-LOW-03]: Internal Node.js WebTorrent micro-daemon port (default: 8889).
# - STREAM_BIND_HOST: Daemon bind interface (default: 127.0.0.1; never expose publicly).
# - STREAMER_TOKEN: Optional daemon shared secret; generated in the cache when blank.
# - STREAM_URL_TTL_SECONDS: Lifetime of signed loopback media URLs (default: 1800).
# - TORRENT_PORT [STRM-LOW-03]: Inbound BitTorrent TCP/uTP peer wire listen port (default: 50000).
# - DHT_PORT [STRM-LOW-03]: Mainline DHT UDP peer discovery port (default: 50001).
# - EVO_DIRECT_RANGE: Direct 307 redirect to the loopback daemon for localhost range requests (default: true; set false to force the Python proxy hop).
# - EVO_PEER_CACHE_FLUSH_MS: Debounce window for persisting the daemon peer cache to disk (default: 15000; lower flushes sooner).
# - EVO_STORE_CACHE_SLOTS [STRM-LOW-01]: In-memory piece chunk cache slots (default: 128, range 16-256).
# - EVO_KEEP_CACHE_MB [STRM-LOW-01]: Disk-resident piece cache budget in MB before LRU purge (default: 15360).
# - EVO_MAX_CONCURRENT_FFMPEG [STRM-HIGH-03]: Max parallel FFmpeg transmux workers (default: 4 or CPU cores).
# - EVO_HLS_MAX_CONCURRENCY [STRM-HIGH-04]: Bounded concurrency semaphore for HLS segment generation (default: 3).
# - EVO_HLS_CACHE_MAX_MB [STRM-HIGH-04]: Disk budget for persistent virtual HLS segment cache (default: 2048 MB).
# - EVO_HLS_LEGACY_SLICE [STRM-HIGH-05]: Force fixed-duration HLS slicing instead of keyframe boundary snapping.

# Decentralized P2P Gossip (CometNet)
COMETNET_ENABLED=true
COMETNET_PORT=8010
# List setting: JSON array, comma-separated values, or blank to disable relays
COMETNET_RELAYS=["wss://relay.comet.cache","wss://cometnet.peer.evo"]
